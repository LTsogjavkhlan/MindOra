# Gmail account used to send contact-form notifications via Nodemailer.
GMAIL_USER=your-gmail-address@gmail.com

# Must be a Google "App Password" (Google Account -> Security -> 2-Step Verification
# -> App Passwords), NOT your normal Gmail login password.
GMAIL_APP_PASSWORD=your-16-character-app-password

# Where contact-form submissions get emailed to.
CONTACT_TO_EMAIL=jawhaa07@gmail.com

# Port the Express API listens on.
PORT=3001

# Set to "production" when deploying: enables secure (HTTPS-only) session cookies.
NODE_ENV=development

# Only set this when the app runs behind a reverse proxy (Render, Railway, nginx...):
# the number of proxies in front of it, so req.ip/HTTPS are read from X-Forwarded-*.
# Leave unset otherwise - trusting the header without a proxy lets clients spoof their IP.
# TRUST_PROXY=1

# Optional: override Node's DNS servers if mongodb+srv:// lookups fail on Windows
# (Node picking up the router's IPv6 DNS). Comma-separated.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# MongoDB Atlas connection string. See SETUP.md for how to create a free cluster.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/stepup

# Cloudinary account (free tier) used to host admin-uploaded images.
# See SETUP.md for how to get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Admin panel login, used once by "node server/seed.js" to create your account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Random string used to sign session cookies. Generate your own with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-string
